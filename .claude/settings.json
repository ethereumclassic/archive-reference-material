{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git subtree *)",
      "Bash(git submodule *)",
      "Bash(git update-ref *)",
      "Bash(git symbolic-ref *)",
      "Bash(git replace *)",
      "Bash(git notes *)",
      "Bash(git reflog *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git clean *)",
      "Bash(git gc *)",
      "Bash(git prune *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(gh api *)",
      "Bash(gh release *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Edit(/LICENSE*)",
      "Edit(/LICENCE*)",
      "Edit(/COPYING*)",
      "Edit(/UNLICENSE*)",
      "Edit(/COPYRIGHT*)",
      "Edit(/*-LICENSE*)",
      "Edit(/license*)",
      "Edit(/licence*)",
      "Edit(/copying*)",
      "Edit(/.github/workflows/**)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)"
    ]
  }
}
